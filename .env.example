REDIS_URL=redis://127.0.0.1:6380
AI_SERVICE_INTERNAL_URL=http://127.0.0.1:8001
# AI_PROVIDER_API_KEY intentionally absent. Real examiner is not configured.

# Step 84 NestJS API (local-only values for Docker Compose)
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
WEB_ORIGIN=http://localhost:3000
PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development
WEB_PUBLIC_ORIGIN=http://localhost:3000
WRITING_API_URL=http://127.0.0.1:3001/api/v1
# LOCAL_PROVISION_* intentionally absent: set only when creating synthetic fixtures.

# Unique HMAC key for pseudonymous, shared PostgreSQL auth abuse budgets (>=48 chars)
AUTH_ABUSE_KEY=LOCAL_SYNTHETIC_KEY_ONLY_CHANGE_BEFORE_ANY_SHARED_DEPLOYMENT_123456789
# Optional comma-separated trusted ingress CIDRs. Empty = ignore client-supplied forwarding headers.
TRUSTED_PROXY_CIDRS=

# Step87 gated, PRIVATE AI service only. Never enter real secrets in this tracked example.
# Actual values must be injected by server-side secrets management after release/privacy approval.
OPENAI_EXAMINER_MODEL=
OPENAI_VERIFIER_MODEL=
