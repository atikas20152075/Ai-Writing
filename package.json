{
  "name": "ai-writing-platform-step85",
  "private": true,
  "version": "0.2.0",
  "description": "Step85 backend integration expansion: staging CI, synthetic HTTP smoke and PostgreSQL contract tests",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "test:domain": "node --experimental-strip-types --test packages/domain/test/*.test.ts",
    "demo": "node --experimental-strip-types scripts/typed-slice-demo.ts",
    "test:policies": "node --experimental-strip-types --test apps/api/test/policies.test.ts apps/api/test/auth-rate-policy.test.ts",
    "test:ai-gateway": "node --experimental-strip-types --test apps/api/test/ai-gateway.test.ts",
    "test": "npm run test:domain && npm run test:policies && npm run test:ai-gateway && npm run test:static && npm run test:assessment",
    "test:python": "cd apps/ai-service && python -m pytest -q",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:static": "node --test scripts/static-invariants.test.mjs",
    "smoke:http": "node scripts/smoke-http-step85.mjs",
    "test:assessment": "node --experimental-strip-types --test apps/api/test/assessment-policy.test.ts"
  },
  "type": "module",
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0"
  }
}
